# Copy into the backend secret manager. Never commit real credentials.
PORT=4000
STARKNET_NETWORK=mainnet
RPC_URL=https://<verified-mainnet-rpc>
CORS_ORIGIN=https://vinss-nu.vercel.app
DATABASE_URL=postgresql://<production-database>
DATABASE_SSL=true

PRIVACY_POOL_ADDRESS=0x<verified-strk20-mainnet-pool>
MESSAGE_HELPER_ADDRESS=0x<vinss-mainnet-message-helper>
OFFER_HELPER_ADDRESS=0x<vinss-mainnet-offer-helper>
PRIVATE_ESCROW_HELPER_ADDRESS=0x<vinss-mainnet-private-escrow-helper>
# Point this at VinssEscrowRekberV2 for the V2 activity indexer.
ESCROW_REKBER_ADDRESS=0x<vinss-mainnet-rekber-v2>

MESSAGE_HELPER_START_BLOCK=<deployment-block>
OFFER_HELPER_START_BLOCK=<deployment-block>
PRIVATE_ESCROW_HELPER_START_BLOCK=<deployment-block>
ESCROW_REKBER_START_BLOCK=<rekber-v2-deployment-block>

AGENT_ENABLED=false
LOYALTY_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
DISCOVER_RATE_LIMIT=120
AGENT_RATE_LIMIT=12
