# Copy to frontend/.env.local only after every address is verified on mainnet.
NEXT_PUBLIC_STARKNET_NETWORK=mainnet
NEXT_PUBLIC_RPC_URL=https://<verified-mainnet-rpc>
NEXT_PUBLIC_BACKEND_URL=https://<vinss-backend>

NEXT_PUBLIC_PRIVACY_POOL_ADDRESS=0x<verified-strk20-mainnet-pool>
NEXT_PUBLIC_MESSAGE_HELPER_ADDRESS=0x<vinss-mainnet-message-helper>
NEXT_PUBLIC_MESSAGE_HELPER_OPEN_NOTE_TOKEN=0x<mainnet-fee-token>
NEXT_PUBLIC_INVITE_ADDRESS=0x<vinss-mainnet-invite>
NEXT_PUBLIC_OFFER_HELPER_ADDRESS=0x<vinss-mainnet-offer-helper>
NEXT_PUBLIC_OFFER_HELPER_OPEN_NOTE_TOKEN=0x<mainnet-fee-token>
NEXT_PUBLIC_PRIVATE_ESCROW_HELPER_ADDRESS=0x<vinss-mainnet-private-escrow-helper>
NEXT_PUBLIC_ESCROW_REKBER_V2_ADDRESS=0x<vinss-mainnet-rekber-v2>
NEXT_PUBLIC_SETTLEMENT_CERTIFICATE_ADDRESS=0x<vinss-mainnet-certificate>
NEXT_PUBLIC_STRK_ADDRESS=0x<verified-mainnet-strk>
NEXT_PUBLIC_USDC_ADDRESS=0x<verified-mainnet-usdc>
NEXT_PUBLIC_VINSS_TREASURY_ADDRESS=0x<vinss-mainnet-treasury>

NEXT_PUBLIC_VINSS_TELEGRAM_URL=https://t.me/<vinss-account>
NEXT_PUBLIC_VINSS_X_URL=https://x.com/<vinss-account>
NEXT_PUBLIC_VINSS_GITHUB_URL=https://github.com/<owner>/<repo>
