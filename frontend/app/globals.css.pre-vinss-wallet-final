@import "tailwindcss";

@theme {
  --color-ink: #0B0D10;
  --color-paper: #F6F5F1;
  --color-vault: #14181D;
  --color-wire: #2B323A;
  --color-signal: #5EEAD4;
  --color-amber: #E8A33D;
  --color-danger: #E2665B;

  --font-display: "IBM Plex Mono", monospace;
  --font-body: "Inter", sans-serif;
}


:root {
  color-scheme: dark;
}

body {
  background-image:
    linear-gradient(180deg, rgba(94, 234, 212, 0.04), transparent 320px),
    repeating-linear-gradient(
      0deg,
      rgba(246, 245, 241, 0.025) 0px,
      rgba(246, 245, 241, 0.025) 1px,
      transparent 1px,
      transparent 28px
    );
}

.ledger-rule {
  border-top: 1px solid rgba(246, 245, 241, 0.12);
}

.seal-tick {
  clip-path: polygon(0 0, 100% 0, 100% 70%, 50% 100%, 0 70%);
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

:focus-visible {
  outline: 2px solid #5eead4;
  outline-offset: 2px;
}

/* --- OVERRIDE MODAL STARKNET (DARK MODE) --- */
/* Latar belakang pop-up modal */
div[role="dialog"], 
div[aria-modal="true"] {
  background-color: var(--color-vault) !important;
  color: var(--color-paper) !important;
  border: 1px solid var(--color-wire) !important;
  border-radius: 1rem !important;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;
}

/* Judul/Teks di dalam modal */
div[role="dialog"] h2, 
div[role="dialog"] h3,
div[aria-modal="true"] h2 {
  color: var(--color-signal) !important;
  font-family: var(--font-display) !important;
}

/* Tombol pilihan dompet (Argent, Braavos, dll) */
div[role="dialog"] button,
div[aria-modal="true"] button {
  background-color: var(--color-ink) !important;
  border: 1px solid var(--color-wire) !important;
  color: var(--color-paper) !important;
  border-radius: 0.75rem !important;
  transition: all 0.2s ease-in-out !important;
}

/* Efek saat tombol dompet disentuh (hover) */
div[role="dialog"] button:hover,
div[aria-modal="true"] button:hover {
  background-color: var(--color-wire) !important;
  border-color: var(--color-signal) !important;
}

/* Layar transparan (backdrop) di belakang modal */
div[id*="headlessui-dialog-overlay"],
div[role="dialog"] > div:first-child {
   background-color: rgba(11, 13, 16, 0.8) !important;
   backdrop-filter: blur(4px) !important;
}

